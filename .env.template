# OMA Lightspeed Environment Variables
# Copy this file to .env and fill in your values
# Or just run 'make generate' for interactive setup

# ─── LLM Provider Configuration ─────────────────────────────────────────────

# Option 1: Gemini API Key (simpler, recommended for local dev)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Option 2: Vertex AI (production-like)
# If using Vertex AI, set GEMINI_API_KEY to "dummy" and provide the service account JSON
# The service account JSON should be placed at: config/vertex-credentials.json

# ─── Image Overrides (optional) ─────────────────────────────────────────────

# Override the lightspeed-stack image
# LIGHTSPEED_STACK_IMAGE=quay.io/lightspeed-core/lightspeed-stack:0.5.1

# Override the MCP server image (default: localhost/oma-service-mcp:latest)
# Build with: make build-mcp
# OMA_MCP_IMAGE=localhost/oma-service-mcp:latest

# Override the migration planner image
# MIGRATION_PLANNER_IMAGE=quay.io/kubev2v/migration-planner-api:latest

# ─── Port Configuration (optional) ──────────────────────────────────────────

# Host port for the Lightspeed API (default: 8080)
# LIGHTSPEED_PORT=8080
